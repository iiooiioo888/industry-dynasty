# 部署目標設定
#
# 這個檔案只放**非機密**的連線資訊。SSH 密碼另外放在同目錄的 `pw` 檔案裡。
# 兩個檔案都在 .gitignore 內，不會被提交。
#
# 填好之後執行：
#   pwsh -File deploy\server-deploy.ps1
# 或先檢查：
#   pwsh -File deploy\server-deploy.ps1 -DryRun

# 主機 IP 或域名
HOST=

# SSH 使用者
USER_NAME=

# SSH 連接埠（預設 22）
PORT=22

# 網站要放的遠端目錄（會整個覆蓋，僅放本專案的靜態檔）
REMOTE_DIR=/var/www/industry-dynasty

# 伺服器上有 Docker 時設為 1：改用容器跑 nginx（需要能拉 nginx 映像）
USE_DOCKER=0

# 對外服務的連接埠（僅在 USE_DOCKER=1 時用來提示網址）
SITE_PORT=8080
